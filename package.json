{
  "name": "@djokodonev/jsonschema-editor-react",
  "version": "3.1.2",
  "description": "JsonSchema Editor React Control",
  "repository": "https://github.com/djokodonev/jsonschema-editor-react",
  "license": "Apache 2.0",
  "engines": {
    "node": ">=10.18.0 <11 || >=12.14.0 <13 || >=13.5.0"
  },
  "source": "src/index.ts",
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "main": "dist/index.js",
  "module": "dist/index.modern.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.modern.js",
      "require": "./dist/index.js",
      "default": "./dist/index.modern.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "readme.md"
  ],
  "keywords": [
    "react"
  ],
  "scripts": {
    "prepublishOnly": "node scripts/guard-publish-registry.mjs",
    "build": "microbundle --jsx React.createElement",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run && npm run test:guard",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:guard": "node scripts/test-guard-publish-registry.mjs",
    "storybook": "rimraf docs && storybook dev -p 6006",
    "build-storybook": "rimraf docs && storybook build --docs -o docs"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0",
    "ajv": "^8.20.0",
    "ramda": "^0.27.1",
    "use-debounce": "^6.0.1"
  },
  "peerDependencies": {
    "antd": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "antd": {
      "optional": false
    }
  },
  "devDependencies": {
    "@ant-design/icons": "^5.5.1",
    "@ant-design/v5-patch-for-react-19": "1.0.3",
    "@chromatic-com/storybook": "^3.2.2",
    "@storybook/addon-console": "^1.2.3",
    "@storybook/addon-essentials": "8.6.18",
    "@storybook/addon-links": "8.6.18",
    "@storybook/react": "8.6.18",
    "@storybook/react-vite": "8.6.18",
    "@storybook/test": "8.6.18",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^20.19.40",
    "@types/ramda": "^0.27.40",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "3.2.7",
    "antd": "^5.22.1",
    "jsdom": "^23.0.0",
    "microbundle": "^0.13.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rimraf": "^5.0.10",
    "storybook": "8.6.18",
    "typescript": "^5.0.0",
    "vitest": "3.2.7"
  }
}
